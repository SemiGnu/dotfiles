
[env]
TERM = "xterm-256color"

[font]
size = 14

[font.normal]
family = "JetBrainsMono Nerd Font Mono"
style = "Regular"

[font.bold]
style = "Bold"

[font.italic]
style = "Italic"

[font.bold_italic]
style = "Bold Italic"

[selection]
save_to_clipboard = true

[window]
decorations = "Full"
# opacity = 0.8

[window.dimensions]
columns = 100
lines = 30

[window.padding]
x = 5
y = 6

